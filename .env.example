PROJECT_ENV=dev
LOG_LEVEL=INFO

# Source: Neon PostgreSQL. Never commit a real value.
DATABASE_URL=postgresql+psycopg://user:password@host/neondb?sslmode=require
SOURCE_SCHEMA=source
CONTROL_SCHEMA=control
PIPELINE_NAME=cross_sell_pipeline

# Free public holiday API (Nager.Date)
HOLIDAY_API_URL=https://date.nager.at/api/v3/PublicHolidays
HOLIDAY_COUNTRY_CODE=PE
API_TIMEOUT_SEC=20
API_MAX_RETRIES=3

# local (default, free), azurite (free emulator), or azure (optional)
DESTINATION=local
OUTPUT_DIR=./out
AZURE_STORAGE_CONTAINER=lakehouse
AZURE_STORAGE_CONNECTION_STRING=

# Explainable association-rule thresholds
MIN_PAIR_INVOICES=2
MIN_SUPPORT=0.0001
MIN_CONFIDENCE=0.01
MIN_LIFT=1.0
MAX_RECOMMENDATIONS_PER_CUSTOMER=10
